# Microsoft Entra ID (Graph API)
# Get these from: Entra ID -> App registrations -> New registration
TENANT_ID=your-tenant-id-guid
CLIENT_ID=your-client-id-guid
CLIENT_SECRET=your-client-secret-string

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b
OLLAMA_TIMEOUT=14400
OLLAMA_RELEVANCE_TIMEOUT=600

# Azure Resource Scanning
# Limits the number of resources scanned to build LLM context
AZURE_RESOURCE_SCAN_LIMIT=5000

# Persistence (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=
LOCAL_DATABASE_URL=

# Notifications (Telegram)
# Message @BotFather on Telegram to create a bot and get a token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Output settings
OUTPUT_FILE=output.txt
