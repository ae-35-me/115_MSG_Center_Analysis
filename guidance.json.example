{
    "org_security_hotspots": [
        {
            "theme": "identity_and_access",
            "description": "Changes to Entra ID (Azure AD) settings, Conditional Access policies, or new high-privilege administrative roles.",
            "escalation": "escalate"
        },
        {
            "theme": "data_exfiltration_risk",
            "description": "New features that enable external sharing by default, new third-party connectors, or changes to anonymous access links.",
            "escalation": "escalate"
        },
        {
            "theme": "ai_and_copilot_safety",
            "description": "Updates to Microsoft 365 Copilot, agentic capabilities, or AI data ingestion paths that could bypass traditional DLP/labels.",
            "escalation": "review"
        },
        {
            "theme": "network_security_drift",
            "description": "Changes to Azure Firewall, NSGs, or default public endpoint settings for storage/databases.",
            "escalation": "review"
        },
        {
            "theme": "compliance_and_governance",
            "description": "New Purview labeling features, retention policy changes, or audit logging gaps introduced by new services.",
            "escalation": "monitor"
        },
        {
            "theme": "identity_governance",
            "description": "Updates to PIM (Privileged Identity Management), access reviews, or entitlement management.",
            "escalation": "review"
        }
    ],
    "risk_rating_rubric": "\nHigh:\n- New or expanded cross-boundary data access (e.g., new sources Copilot/agents can ingest; new connectors; new default sharing paths)\n- Bypass/weakening of existing controls (labels/DLP/IB/CA) or reduced ability to enforce them\n- Material identity/permission model changes (new admin roles, broader default scopes)\n- Compliance impact with short timelines (action required soon)\n\nMedium:\n- New capability that increases attack surface, but mitigations exist or are configurable\n- Control changes are optional / off by default, but likely to be adopted\n- Logging/visibility changes that require uplift\n\nLow:\n- UI/UX change, non-security feature, or security improvement with no action required\n- Changes confined to out-of-scope services\n"
}
